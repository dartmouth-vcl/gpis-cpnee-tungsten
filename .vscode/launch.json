{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Tungsten",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/Debug/tungsten",
            "args": [
                "${workspaceFolder}/scenes/veach-gpis-anisotropic-4/veach-cpnee-anisotropic-renewalhalfplus-64spp.json"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}